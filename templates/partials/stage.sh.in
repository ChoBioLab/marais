# resolve the snapshot on the compute node (never on the login node)
SNAP=$(ls -1dt "$hf_home"/hub/models--$model_slug/snapshots/* 2>/dev/null | head -1)
if [ ! -d "$SNAP" ]; then
  echo "FATAL: $model_repo not found under $hf_home" >&2
  echo "  looked for: $hf_home/hub/models--$model_slug/snapshots/*" >&2
  exit 1
fi
echo "source: $SNAP"

if [ "$stage_ssd" = "1" ]; then
  # -L: snapshot files are symlinks into ../../blobs; copy the targets
  STAGE_DIR="/ssd/marais_${LSB_JOBID}"
  mkdir -p "$STAGE_DIR"
  rsync -aL --info=progress2 "$SNAP"/ "$STAGE_DIR"/
  export MODEL_PATH="$STAGE_DIR"
else
  export MODEL_PATH="$SNAP"
fi
echo "model: $MODEL_PATH"

