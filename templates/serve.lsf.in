#!/bin/bash
#BSUB -J $job
#BSUB -P $project
#BSUB -q $queue
#BSUB -n $ncpus
#BSUB -R "span[hosts=1]"
#BSUB -R "rusage[mem=$mem$ssd_res]"
#BSUB -R "$gpu_res"
#BSUB -gpu "num=$ngpus"
#BSUB -W $walltime
#BSUB -o $log_dir/%J.stdout
#BSUB -eo $log_dir/%J.stderr
#BSUB -L /bin/bash

umask 002
ulimit -n 65536
mkdir -p "$log_dir" "$state_dir"
chmod 2775 "$state_dir" 2>/dev/null || true

echo "=== ${LSB_JOBID} $(hostname) $(date -Is) ==="
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader

ml apptainer
ml proxies

trap 'rm -f "$state_dir/${LSB_JOBID}.json"; rm -rf "/ssd/chuangai_${LSB_JOBID}"' EXIT

$STAGE

# nodes are shared: pick a free loopback port instead of assuming 8000
PORT=$((20000 + RANDOM % 20000))
while (exec 3<>/dev/tcp/127.0.0.1/$PORT) 2>/dev/null; do
  PORT=$((20000 + RANDOM % 20000))
done
echo "port: $PORT"

apptainer run --nv -B /sc/arion \
  --env HF_HOME=$hf_home --env HF_HUB_OFFLINE=1 --env TRANSFORMERS_OFFLINE=1 \
  --env VLLM_LOGGING_LEVEL=INFO \
  $sif "$MODEL_PATH" \
  --served-model-name $served \
  --host 127.0.0.1 --port $PORT \
  --api-key "$(cat $keyfile)" \
  --max-model-len $max_len \
  --tensor-parallel-size $tp \
  --kv-cache-dtype fp8 \
  --enable-auto-tool-choice --tool-call-parser $parser \
  --enable-prefix-caching --enable-chunked-prefill $extra &

VLLM_PID=$!
$HEALTH
wait $VLLM_PID
